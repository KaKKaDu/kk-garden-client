    "start": "npm run env-validate && npm run check && next start",
    "env-validate": "tsx scripts/env-validate.ts",
    "check": "tsx scripts/check.ts",
    "lint": "eslint .",
    "shared": "npm install @kk-garden/shared@latest",
    "typescript": "tsc --noEmit --project tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.5",
    "@hookform/resolvers": "^6.0.2",
